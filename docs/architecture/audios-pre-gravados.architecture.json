    { "id": "storage", "lane": "config", "label": "ffmpeg → Storage privado", "sublabel": "Ogg/Opus imutável" },
    { "id": "catalogo", "lane": "turno", "label": "ai_agents.config.approved_audios" },
    { "id": "modelo", "lane": "turno", "label": "agent-config → catálogo no turno → send_message" },
    { "id": "sink", "lane": "entrega", "label": "prepareAgentMedia → outbound-attempt", "sublabel": "Aprovação fresca, inbound atual, lease e ledger" },
    { "id": "canal", "lane": "entrega", "label": "Handler de mensagens → adapter do canal" },
    { "id": "inbox", "lane": "entrega", "label": "Inbox: áudio, histórico e estado de entrega" }
