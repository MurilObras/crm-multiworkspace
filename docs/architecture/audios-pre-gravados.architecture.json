  "edges": [
    { "id": "e1", "from": "editor", "to": "api", "label": "anexar, aprovar, ouvir e desativar" },
    { "id": "e2", "from": "api", "to": "storage", "label": "normalizar arquivo aprovado" },
    { "id": "e3", "from": "storage", "to": "catalogo", "label": "referência privada, sem URL assinada persistida" },
    { "id": "e4", "from": "api", "to": "catalogo", "label": "CAS da configuração operacional" },
    { "id": "e5", "from": "catalogo", "to": "modelo", "label": "IDs aprovados, título e finalidade" },
    { "id": "e6", "from": "modelo", "to": "sink", "label": "texto de contexto e áudio em intenções próprias" },
    { "id": "e7", "from": "catalogo", "to": "sink", "label": "revalidar retirada de aprovação antes da rede" },
    { "id": "e8", "from": "sink", "to": "canal", "label": "mesma fila, sem duplicar replay" },
    { "id": "e9", "from": "canal", "to": "inbox", "label": "arquivo e desfecho visíveis" },
    { "id": "e10", "from": "inbox", "to": "editor", "label": "humano avalia e retira gravação inadequada" }
  ]
