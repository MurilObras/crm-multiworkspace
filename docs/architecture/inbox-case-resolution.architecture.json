{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": { "title": "Resposta humana e retorno ao automático", "output": "inbox-case-resolution.html", "quality_profile": "standard" },
  "lanes": [{ "id": "ui", "label": "Operação" }, { "id": "runtime", "label": "Serviços e banco" }],
  "mainPath": ["choice", "intent", "confirmation", "resolution", "progress"],
  "nodes": [
    { "id": "choice", "lane": "ui", "col": 1, "type": "frontend", "label": "Inbox: escolha de consulta por resposta" },
    { "id": "intent", "lane": "runtime", "col": 2, "type": "backend", "label": "Intenção validada e revisão de comando" },
    { "id": "confirmation", "lane": "runtime", "col": 3, "type": "backend", "label": "Confirmação de transporte e evento durável" },
    { "id": "resolution", "lane": "runtime", "col": 4, "type": "backend", "label": "Consumidor: caso, memória e bloqueios" },
    { "id": "progress", "lane": "ui", "col": 5, "type": "frontend", "label": "Progresso e consulta acionável" },
    { "id": "followup", "lane": "runtime", "col": 5, "type": "backend", "label": "ai.handoff_resolved: acompanhamentos elegíveis" },
    { "id": "next-turn", "lane": "runtime", "col": 6, "type": "backend", "label": "Nova pergunta usa decisão humana sem repetir resposta antiga" }
  ],
  "edges": [
    { "from": "choice", "to": "intent" },
    { "from": "intent", "to": "confirmation" },
    { "from": "confirmation", "to": "resolution" },
    { "from": "resolution", "to": "progress" },
    { "from": "progress", "to": "choice", "label": "conferência humana quando impedido" },
    { "from": "resolution", "to": "followup" },
    { "from": "resolution", "to": "next-turn" },
    { "from": "next-turn", "to": "choice", "label": "novas consultas, quando necessário" }
  ]
}
